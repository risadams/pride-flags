{
  "name": "@risadams/pride-flags",
  "version": "1.1.0",
  "description": "Pure CSS Pride Flags",
  "main": "dist/pride-flags.min.css",
  "style": "dist/pride-flags.min.css",
  "sass": "src/pride-flags.scss",
  "exports": {
    ".": {
      "style": "./dist/pride-flags.min.css",
      "default": "./dist/pride-flags.min.css"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.css",
    "src/pride-flags.scss"
  ],
  "scripts": {
    "build:compile": "sass --style=expanded --no-source-map src/pride-flags.scss dist/pride-flags.css",
    "build:minify": "cleancss --format breaksWith=lf --output dist/pride-flags.min.css dist/pride-flags.css",
    "build": "npm run build:compile && npm run build:minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/risadams/pride-flags.git"
  },
  "keywords": [
    "css",
    "pride",
    "flags"
  ],
  "author": "Ris Adams",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/risadams/pride-flags/issues"
  },
  "homepage": "https://github.com/risadams/pride-flags#readme",
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "sass": "^1.106.1"
  }
}
